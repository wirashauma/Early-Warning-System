# Frontend runs on a non-default local port to avoid 3000.
PORT=4000

# URL API memakai same-origin path /api agar Next.js bisa proxy ke backend
# Prefix NEXT_PUBLIC_ wajib ditambahkan agar variabel ini bisa dibaca oleh browser (Client-Side)
