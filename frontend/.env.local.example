# .env.local - Development Environment Variables (DO NOT COMMIT)
# Copy this file to .env.local and fill in your development values
# This file overrides .env values and is ignored by Git

# Use a separate API key for local development if your production key has restrictions
# To create a development API key:
# 1. Go to https://console.cloud.google.com/
# 2. APIs & Services > Credentials
# 3. Create a new API Key (or use an unrestricted one)
# 4. Add it below
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_development_api_key_here"

# Optional: Override API URL for local testing
# NEXT_PUBLIC_API_URL="/api"
# PORT=4100

# If you expose the backend through ngrok, set these values instead:
# NEXT_PUBLIC_API_URL="https://your-ngrok-domain.ngrok-free.app/api"
# NEXT_PUBLIC_WS_URL="wss://your-ngrok-domain.ngrok-free.app"
