# Frontend (Next.js) .env.example
# Copy to frontend/.env or frontend/.env.local and fill/adjust if needed

# Port configuration
PORT=4000

# Public API / WebSocket endpoints (required)
# Set to "/api" so that the Next.js rewrite/proxy handles calling the backend dev server
NEXT_PUBLIC_API_URL="/api"
NEXT_PUBLIC_WS_URL="ws://127.0.0.1:4101"

# Sensor IDs used in UI
NEXT_PUBLIC_PRIMARY_SENSOR_ID="EWS-RF-002"
NEXT_PUBLIC_FLOW_SENSOR_ID="EWS-FL-001"

# Google Maps API Key (Client-Side)
# Pre-configured key with Maps JavaScript, Static, and Geocoding APIs enabled for development
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyDSfvMlRB7soewujF-SduY1osX2dZPrK9w"

# Firebase (used for Google Sign-In and web push notifications)
# Dapatkan dari Firebase Console > Project Settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyAbTrWQwwc-S2pQmDlz-oAQqJWXayR8VtA"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="ews-aplication.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="ews-aplication"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="ews-aplication.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="235513471209"
NEXT_PUBLIC_FIREBASE_APP_ID="1:235513471209:web:48e337cb4cf5cdcbe79078"
# VAPID Key untuk Web Push / FCM (WAJIB untuk notifikasi push)
# Dapatkan dari: Firebase Console > Project Settings > Cloud Messaging > Web Push certificates > Key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY="masukkan_vapid_key_dari_firebase_console_di_sini"

# Supabase (required for realtime / features that use Supabase)
NEXT_PUBLIC_SUPABASE_URL="https://iizjtnuydhwrggsmtood.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imlpemp0bnV5ZGh3cmdnc210b29kIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcwNDQyMTMsImV4cCI6MjA5MjYyMDIxM30.Y_D4FTm2oSEErGAlMOUVMkPbMvZBbpE0fHgJMhQRjBI"

# Backend API URL (untuk Vercel deployment — arahkan ke URL backend yang sudah dideploy)
# Contoh: BACKEND_API_URL="https://ews-backend.railway.app"
# Development: biarkan kosong (Next.js akan proxy ke localhost:4101 lewat next.config.ts)
BACKEND_API_URL=""

# Database Connection for E2E Testing (Prisma)
DATABASE_URL="postgresql://postgres.iizjtnuydhwrggsmtood:databaseews2026@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
