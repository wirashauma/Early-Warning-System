# App
PORT=4101
NODE_ENV=development
# Allow browser clients served from ngrok domains during development
ALLOW_NGROK_ORIGINS=true

# Supabase PostgreSQL (pooler URL for runtime queries)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct database URL (for Prisma migrate)
DIRECT_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Optional Supabase API (if later needed for storage/auth integration)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# Firebase Admin SDK (server-side)
FIREBASE_PROJECT_ID="ews-aplication"
FIREBASE_SERVICE_ACCOUNT_PATH="config/firebase-service-account.json"

# FCM default topic for alert broadcasting
FCM_DEFAULT_TOPIC="ews-alerts"

# JWT secret used for signing access tokens (override in production)
JWT_SECRET="your_jwt_secret_here"

# SMTP (optional) - set these to enable email delivery
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp_user"
SMTP_PASS="smtp_password"
SMTP_FROM="no-reply@example.com"

# CORS / Allowed origins (comma separated)
# Example: ALLOWED_ORIGINS="http://localhost:4100,https://your-frontend.example.com"
ALLOWED_ORIGINS=""

