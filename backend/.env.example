# App
PORT=4101
NODE_ENV=development
# Allow browser clients served from ngrok domains during development
ALLOW_NGROK_ORIGINS=true

# Supabase PostgreSQL (pooler URL for runtime queries)
DATABASE_URL="postgresql://postgres.iizjtnuydhwrggsmtood:databaseews2026@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Direct database URL (for Prisma migrate)
DIRECT_URL="postgresql://postgres.iizjtnuydhwrggsmtood:databaseews2026@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Optional Supabase API (if later needed for storage/auth integration)
SUPABASE_URL="https://iizjtnuydhwrggsmtood.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# Firebase Admin SDK (server-side)
FIREBASE_PROJECT_ID="ews-aplication"
FIREBASE_SERVICE_ACCOUNT_PATH="config/firebase-service-account.json"
# Alternatif untuk cloud hosting (Railway/Render/Fly.io): isi dengan konten JSON satu baris
# Jika diisi, FIREBASE_SERVICE_ACCOUNT_JSON diprioritaskan di atas FIREBASE_SERVICE_ACCOUNT_PATH
FIREBASE_SERVICE_ACCOUNT_JSON=""

# FCM default topic for alert broadcasting
FCM_DEFAULT_TOPIC="ews-alerts"

# JWT secret used for signing access tokens (override in production)
JWT_SECRET="masukkan_rahasia_jwt_yang_sangat_panjang_dan_acak_di_sini"

# SMTP (optional) - set these to enable email delivery
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp_user"
SMTP_PASS="smtp_password"
SMTP_FROM="no-reply@example.com"

# CORS / Allowed origins (comma separated)
# Example: ALLOWED_ORIGINS="http://localhost:4100,https://your-frontend.example.com"
ALLOWED_ORIGINS=""

